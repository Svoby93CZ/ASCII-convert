    <string name="about_title">ASCII Studio %1$s</string>
    <string name="about_text">Turns photos into text art right on your device. Nothing is uploaded anywhere.\n\nFont: JetBrains Mono, SIL Open Font License 1.1\nIcons: Material Symbols, Apache License 2.0</string>
