<?xml version="1.0" encoding="utf-8"?>
<!-- Only the user's style settings are backed up; images stay on the device. -->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="file"
            path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="file"
            path="datastore/" />
    </device-transfer>
</data-extraction-rules>
